<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restricted Access - NTI</title>
    <style>
        :root {
            --bg-color: #05070a;
            --accent-gold: #f3e5ab;
            --accent-gold-dark: #d4af37;
            --text-main: #f9fafb;
            --border-color: rgba(212, 175, 55, 0.2);
        }
        body {
            font-family: "Times New Roman", Times, serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex; justify-content: center; align-items: center;
            height: 100vh; margin: 0;
        }
        .login-box {
            background: rgba(15, 22, 36, 0.9); padding: 30px;
            border: 1px solid var(--border-color); border-top: 3px solid var(--accent-gold-dark);
            border-radius: 6px; width: 320px; box-shadow: 0 4px 20px rgba(0,0,0,0.8);
        }
        h2 { color: var(--accent-gold); font-size: 12pt; text-transform: uppercase; margin-bottom: 20px; text-align: center; letter-spacing: 1px; }
        input { width: 100%; padding: 10px; background: #05070a; border: 1px solid var(--border-color); color: var(--text-main); margin-bottom: 15px; border-radius: 4px; font-family: inherit; }
        button { width: 100%; background: linear-gradient(135deg, var(--accent-gold-dark), #b38f27); color: #05070a; font-weight: bold; border: none; padding: 10px; cursor: pointer; text-transform: uppercase; border-radius: 4px; font-family: inherit; }
        .error { color: #f87171; font-size: 8.5pt; margin-bottom: 15px; text-align: center; }
    </style>
</head>
<body>
    <div class="login-box">
        <h2>Restricted Access</h2>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form method="POST">
            <input type="password" name="password" required placeholder="Weka nenosiri la siri...">
            <button type="submit">Ingia Kwenye Mfumo</button>
        </form>
    </div>
</body>
</html>
